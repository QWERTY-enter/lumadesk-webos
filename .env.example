# Generate a real .env with ./scripts/setup.sh
WEBOS_PASSWORD=replace-with-a-long-random-password
WEBOS_SECRET=replace-with-at-least-32-random-characters
WEBOS_IMAGE=ghcr.io/qwerty-enter/lumadesk-webos:1.4.0
WEBOS_BIND=127.0.0.1
WEBOS_PORT=8080
WEBOS_DOMAIN=os.example.com
WEBOS_SECURE_COOKIE=auto
# Set to public to start the Caddy HTTPS gateway automatically.
COMPOSE_PROFILES=
# API sliding-window throttle per client address per minute (0 disables).
WEBOS_RATE_LIMIT=600
# Concurrent browser terminal (PTY) sessions, 1-1024.
WEBOS_MAX_TERMINALS=16
# Optional bearer token (16+ characters) so Prometheus can scrape /metrics
# without a login session: Authorization: Bearer <token>
WEBOS_METRICS_TOKEN=
